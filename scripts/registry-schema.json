{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["core"],
  "additionalProperties": false,
  "properties": {
    "core": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/entry" }
    },
    "post_types":  { "type": "array", "items": { "$ref": "#/definitions/entry" } },
    "syndicators": { "type": "array", "items": { "$ref": "#/definitions/entry" } },
    "endpoints":   { "type": "array", "items": { "$ref": "#/definitions/entry" } }
  },
  "definitions": {
    "entry": {
      "type": "object",
      "required": ["key", "package"],
      "additionalProperties": false,
      "properties": {
        "key":             { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "package":         { "type": "string", "pattern": "^@[a-z0-9-]+/[a-z0-9-]+$" },
        "version":         { "type": "string" },
        "overridden":      { "type": "boolean" },
        "library":         { "type": "boolean" },
        "default_enabled": { "type": "boolean" }
      }
    }
  }
}
